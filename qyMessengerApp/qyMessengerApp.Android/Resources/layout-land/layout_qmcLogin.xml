<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">



	<LinearLayout
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
   >

		<TextView
            android:id="@+id/textView_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清扬"
            android:textColor="#000000"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

		<TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="视频指挥系统"
            android:textColor="#000000"
            android:textSize="@dimen/description_text_size" />


		<TextView
            android:id="@+id/textView_server"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_services_tv_margin_top"
            android:text="服务器地址:"
            android:textColor="#000000"
            android:textSize="@dimen/login_tv_text_size" />

		<EditText
            android:id="@+id/editText_server"
            android:layout_width="@dimen/login_edit_width"
            android:layout_height="@dimen/login_edit_height"
            android:layout_marginTop="@dimen/login_tv_margin_top"
            android:background="@drawable/edit_style_text"
            android:hint="请输入"
            android:inputType="textPersonName"
            android:textSize="@dimen/login_edit_text_size"

            />

		<TextView
            android:id="@+id/textView_usrName"
            android:layout_width="@dimen/login_edit_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_tv_margin_top"
            android:text="用户名:"
            android:textColor="#000000"
            android:textSize="@dimen/login_tv_text_size"

            />

		<EditText
            android:id="@+id/editText_usrName"
            android:layout_width="@dimen/login_edit_width"
            android:layout_height="34dp"
            android:layout_marginTop="@dimen/login_tv_margin_top"
            android:background="@drawable/edit_style_text"
            android:hint="请输入"
            android:inputType="textPersonName"
            android:textSize="@dimen/login_edit_text_size"

            />

		<TextView
            android:id="@+id/textView_passwd"
            android:layout_width="@dimen/login_edit_width"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/login_tv_margin_top"
            android:text="密码:"
            android:textColor="#000000"
            android:textSize="@dimen/login_tv_text_size"

            />

		<EditText
            android:id="@+id/editText_passwd"
            android:layout_width="@dimen/login_edit_width"
            android:layout_height="34dp"
            android:layout_marginTop="@dimen/login_tv_margin_top"
            android:background="@drawable/edit_style_text"
            android:hint="请输入"
            android:inputType="textPassword"
            android:textSize="@dimen/login_edit_text_size" />

		<TextView
			android:clickable="true"
            android:focusable="true"
            android:id="@+id/button_login"
            android:layout_width="@dimen/login_edit_width"
            android:layout_height="@dimen/login_tv_login"
            android:layout_marginTop="@dimen/login_button_margin_top"
            android:background="#0083ff"
            android:gravity="center"
            android:text="登录"
            android:textColor="#ffffff"
            android:textSize="@dimen/login_button_text_size" />
		<FrameLayout
            android:layout_marginTop="14dp"
            android:layout_width="300dp"
            android:layout_height="wrap_content">
			<TextView
                android:visibility="invisible"
                android:layout_gravity="end"
                android:id="@+id/change_passwd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="修改密码"
                android:textColor="#0083ff"
                android:textSize="16sp"

                />
		</FrameLayout>
	</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>